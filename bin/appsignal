#!/usr/bin/env php
<?php

$scriptDir = dirname(__FILE__);
$packageDir = dirname($scriptDir);
$appPath = getcwd();

require $appPath . '/vendor/autoload.php';

use Appsignal\CLI\Application;
use Appsignal\CLI\Commands\DemoCommand;
use Appsignal\CLI\Commands\InstallCommand;
use Appsignal\CLI\Commands\ValidateCommand;

$app = new Application('AppSignal');
$app->addCommand(new InstallCommand(packageDir: $packageDir, appPath: $appPath));
$app->addCommand(new ValidateCommand($appPath));
$app->addCommand(new DemoCommand($appPath));
$app->run();
