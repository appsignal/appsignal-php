#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PACKAGE_DIR="${APPSIGNAL_PACKAGE_DIR:-$(dirname "$SCRIPT_DIR")}"

# Package is located in vendor/appsignal/appsignal-php directory
# and the project root is three levels up from the package directory.
PROJECT_ROOT="${APPSIGNAL_PROJECT_ROOT:-$(dirname "$(dirname "$(dirname "$PACKAGE_DIR")")")}"
AUTOLOAD="${APPSIGNAL_AUTOLOAD_PATH:-$PROJECT_ROOT/vendor/autoload.php}"

case "${1:-}" in
	init)
		TARGET_DIR="$PROJECT_ROOT/config"
		TEMPLATE="$PACKAGE_DIR/config-stubs/appsignal.php"
		FRAMEWORK=""
		# Detect framework
		if [ -f "$PROJECT_ROOT/symfony.lock" ]; then
			FRAMEWORK="symfony"
		elif [ -f "$PROJECT_ROOT/artisan" ] && [ -d "$PROJECT_ROOT/bootstrap" ]; then
			TEMPLATE="$PACKAGE_DIR/config-stubs/appsignal.laravel.php"
			FRAMEWORK="laravel"
		fi

		TARGET="$TARGET_DIR/appsignal.php"

		if [ -f "$TARGET" ]; then
			echo "Config file already exists at $TARGET"
			exit 0
		fi

		mkdir -p "$TARGET_DIR"
		cp "$TEMPLATE" "$TARGET"
		echo "Appsignal config file created at $TARGET"

		if [ "$FRAMEWORK" = "laravel" ]; then
			echo "Installing open-telemetry/opentelemetry-auto-laravel..."
			composer --working-dir="$PROJECT_ROOT" require open-telemetry/opentelemetry-auto-laravel
		elif [ "$FRAMEWORK" = "symfony" ]; then
			echo "Installing open-telemetry/opentelemetry-auto-symfony..."
			composer --working-dir="$PROJECT_ROOT" require open-telemetry/opentelemetry-auto-symfony
		fi
		;;
	validate)
		php "${PACKAGE_DIR}/bin/validate.php" "$PROJECT_ROOT" "$AUTOLOAD"
		;;
	*)
		echo "Usage: appsignal <command>"
		echo ""
		echo "Commands:"
		echo "  init        Scaffold Appsignal config file and add auto-instrumentations"
		echo "  validate    Check if Appsignal config is valid"
		;;
esac
